# Copy to scripts/config.env. Do not commit config.env if you customize secrets.
BACKEND_DIR=apps/backend
STOREFRONT_DIR=apps/storefront
BACKEND_PORT=8218
STOREFRONT_PORT=9900
PG_PORT=5432
PG_SERVICE=postgresql@16
# Override only if your package.json scripts are nonstandard.
# Commands run from the respective app directories via bash -lc.
BACKEND_START_COMMAND='npm run dev'
STOREFRONT_START_COMMAND='npx --no-install next dev -p 9900'
# Set to 1 to automatically start Homebrew PostgreSQL when needed.
AUTO_START_POSTGRES=1
